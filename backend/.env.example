# 本機開發可繼續用 SQLite：把 schema.prisma 的 provider 改回 "sqlite"
# DATABASE_URL="file:./dev.db"

# 正式環境：Supabase PostgreSQL
# Supabase → Project Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.XXXX.supabase.co:5432/postgres"

JWT_SECRET="請改成很長的隨機字串至少32字元"
JWT_EXPIRES_IN="7d"
PORT=3001

# 前端網域，多個用逗號分隔
CORS_ORIGIN="http://localhost:5173,https://your-app.vercel.app"
