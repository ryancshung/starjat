{
  "name": "starjar-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "prisma db push --skip-generate && node dist/index.js",
    "worker:dev": "wrangler dev src/worker.ts",
    "worker:deploy": "prisma generate && wrangler deploy",
    "worker:typecheck": "prisma generate && tsc --noEmit -p tsconfig.worker.json",
    "test": "tsx --test tests/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "@neondatabase/serverless": "1.1.0",
    "@prisma/adapter-neon": "6.16.0",
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "hono": "^4.13.3",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.16.0",
    "wrangler": "^4.125.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18"
  }
}
