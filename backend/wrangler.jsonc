{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starjar-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c73b0feb0ae9499a9e43e570669c3511"
    }
  ]
}
