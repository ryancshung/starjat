generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 使用 String 取代 enum，相容性較好
// Role: ADMIN | PARENT | CHILD
// TransactionType: EARN | SPEND | ADJUST
// TaskStatus / RedemptionStatus: PENDING | APPROVED | REJECTED

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("PARENT") // ADMIN | PARENT | CHILD
  points       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships       FamilyMember[]
  pointTransactions PointTransaction[]
  createdTasks      Task[]             @relation("TaskCreator")
  taskCompletions   TaskCompletion[]
  createdRewards    Reward[]           @relation("RewardCreator")
  redemptions       RewardRedemption[]
  wishes            Wish[]
}

model Family {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  ownerId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members FamilyMember[]
  tasks   Task[]
  taskGroups TaskGroup[]
  rewards Reward[]
  wishes  Wish[]
  scheduledAwards ScheduledAward[]
}

model ScheduledAward {
  id          String   @id @default(cuid())
  familyId    String
  userId      String
  createdById String
  name        String
  amount      Int
  frequency   String   // daily | weekly | monthly
  startAt     DateTime @default(now())
  lastPaidAt  DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id       String   @id @default(cuid())
  familyId String
  userId   String
  joinedAt DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
}

model PointTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  type      String   // EARN | SPEND | ADJUST
  reason    String
  createdBy String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id            String   @id @default(cuid())
  familyId      String
  groupId       String?
  createdById   String
  title         String
  description   String?
  points        Int
  isRecurring   Boolean  @default(false)
  recurringType String?  // daily | weekly
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  keepAfterCompletion Boolean @default(true)
  maxCompletions Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  family      Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  group       TaskGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy   User             @relation("TaskCreator", fields: [createdById], references: [id])
  completions TaskCompletion[]
}

model TaskGroup {
  id        String   @id @default(cuid())
  familyId  String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  tasks  Task[]

  @@unique([familyId, name])
}

model TaskCompletion {
  id          String    @id @default(cuid())
  taskId      String
  userId      String
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  note        String?
  completedAt DateTime  @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reward {
  id          String   @id @default(cuid())
  familyId    String
  createdById String
  title       String
  description String?
  cost        Int
  isActive    Boolean  @default(true)
  sortOrder  Int      @default(0)
  keepAfterRedemption Boolean @default(true)
  maxRedemptions Int?
  discountPercent Int?
  discountStart DateTime?
  discountEnd DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family      Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("RewardCreator", fields: [createdById], references: [id])
  redemptions RewardRedemption[]
}

model Wish {
  id        String   @id @default(cuid())
  familyId  String
  userId    String
  title     String
  description String?
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedBy String?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RewardRedemption {
  id         String    @id @default(cuid())
  rewardId   String
  userId     String
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  reviewedBy String?

  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
