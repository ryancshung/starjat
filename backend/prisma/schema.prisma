generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 使用 String 取代 enum，相容性較好
// Role: ADMIN | PARENT | CHILD
// TransactionType: EARN | SPEND | DEDUCT | REVERSAL | ADJUST
// TaskStatus / RedemptionStatus: PENDING | APPROVED | REJECTED | CANCELLED

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("PARENT") // ADMIN | PARENT | CHILD
  points       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships       FamilyMember[]
  pointTransactions PointTransaction[]
  createdTasks      Task[]             @relation("TaskCreator")
  taskCompletions   TaskCompletion[]
  createdRewards    Reward[]           @relation("RewardCreator")
  redemptions       RewardRedemption[]
  allowanceRedemptions AllowanceRedemption[]
  userTrophies      UserTrophy[]
  wishes            Wish[]
}

model Family {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  ownerId    String
  timezone   String   @default("Asia/Taipei")
  pointsPerTwd Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members FamilyMember[]
  tasks   Task[]
  taskGroups TaskGroup[]
  rewards Reward[]
  wishes  Wish[]
  scheduledAwards ScheduledAward[]
  allowanceRedemptions AllowanceRedemption[]
  trophyDefinitions TrophyDefinition[]
}

model ScheduledAward {
  id          String   @id @default(cuid())
  familyId    String
  userId      String
  createdById String
  name        String
  amount      Int
  frequency   String   // daily | weekly | monthly
  startAt     DateTime @default(now())
  localTime   String   @default("09:00")
  weekday     Int?
  dayOfMonth  Int?
  nextRunAt   DateTime?
  lastPaidAt  DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id       String   @id @default(cuid())
  familyId String
  userId   String
  joinedAt DateTime @default(now())
  canDeductPoints Boolean @default(false)
  monthlyAllowanceLimitTwd Int?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
}

model PointTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  type      String   // EARN | SPEND | ADJUST
  reason    String
  createdBy String?
  balanceBefore Int?
  balanceAfter Int?
  reversalOfId String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id            String   @id @default(cuid())
  familyId      String
  groupId       String?
  createdById   String
  title         String
  description   String?
  points        Int
  isRecurring   Boolean  @default(false)
  recurringType String?  // daily | weekly
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  keepAfterCompletion Boolean @default(true)
  maxCompletions Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  family      Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  group       TaskGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy   User             @relation("TaskCreator", fields: [createdById], references: [id])
  completions TaskCompletion[]
}

model TaskGroup {
  id        String   @id @default(cuid())
  familyId  String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  tasks  Task[]

  @@unique([familyId, name])
}

model TaskCompletion {
  id          String    @id @default(cuid())
  taskId      String
  userId      String
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  note        String?
  completedAt DateTime  @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  requestId   String?
  localDate   String?
  pointsSnapshot Int?
  titleSnapshot String?
  // Non-null only while pending, or approved for a daily task.
  activeKey   String? @unique
  requests TaskSubmissionRequest[]

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([userId, localDate, status])
}

// Scalar IDs intentionally preserve historical snapshots when source settings change.
model DailyTaskVersion {
  id String @id @default(cuid())
  taskId String
  familyId String
  effectiveDate String
  config Json
  @@unique([taskId, effectiveDate])
  @@index([familyId, effectiveDate])
}

model DailyChallenge {
  id String @id @default(cuid())
  familyId String
  createdAt DateTime @default(now())
  versions DailyChallengeVersion[]
  @@index([familyId])
}

model DailyChallengeVersion {
  id String @id @default(cuid())
  challengeId String
  effectiveDate String
  title String
  taskIds Json
  childIds Json
  bonusStars Int
  customTitle String?
  customDescription String?
  isActive Boolean @default(true)
  challenge DailyChallenge @relation(fields: [challengeId], references: [id])
  @@unique([challengeId, effectiveDate])
}

model TaskDaySnapshot {
  id String @id @default(cuid())
  familyId String
  userId String
  localDate String
  tasks Json
  challenges Json
  createdAt DateTime @default(now())
  @@unique([familyId, userId, localDate])
  @@index([familyId, localDate])
}

model TaskSubmissionRequest {
  id String @id @default(cuid())
  userId String
  requestId String
  completionId String
  completion TaskCompletion @relation(fields: [completionId], references: [id], onDelete: Cascade)
  @@unique([userId, requestId])
}

model ChallengeAward {
  id String @id @default(cuid())
  familyId String
  challengeId String
  userId String
  localDate String
  title String
  bonusStars Int
  customTitle String?
  customDescription String?
  earnedAt DateTime @default(now())
  fulfilledAt DateTime?
  fulfilledBy String?
  @@unique([challengeId, userId, localDate])
  @@index([familyId, userId, earnedAt])
}

model Reward {
  id          String   @id @default(cuid())
  familyId    String
  createdById String
  title       String
  description String?
  cost        Int
  isActive    Boolean  @default(true)
  sortOrder  Int      @default(0)
  keepAfterRedemption Boolean @default(true)
  maxRedemptions Int?
  discountPercent Int?
  discountStart DateTime?
  discountEnd DateTime?
  availabilityMode String @default("ALWAYS") // ALWAYS | WEEKENDS | DATES | WEEKENDS_OR_DATES
  availableStartTime String?
  availableEndTime String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family      Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("RewardCreator", fields: [createdById], references: [id])
  redemptions RewardRedemption[]
  availableDates RewardAvailabilityDate[]
}

model RewardAvailabilityDate {
  id       String @id @default(cuid())
  rewardId String
  date     String // YYYY-MM-DD in the family's timezone

  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([rewardId, date])
}

model Wish {
  id        String   @id @default(cuid())
  familyId  String
  userId    String
  title     String
  description String?
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedBy String?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RewardRedemption {
  id         String    @id @default(cuid())
  rewardId   String
  userId     String
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  reviewedBy String?
  reservedPoints Int @default(0)
  costSnapshot Int?
  availabilitySnapshot String?
  cancelledAt DateTime?

  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AllowanceRedemption {
  id                   String   @id @default(cuid())
  familyId             String
  userId               String
  amountTwd            Int
  pointsPerTwdSnapshot Int
  reservedPoints       Int
  status               String   @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  createdAt            DateTime @default(now())
  reviewedAt           DateTime?
  reviewedBy           String?
  cancelledAt          DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId, status])
  @@index([userId, createdAt])
}

model TrophyDefinition {
  id          String   @id @default(cuid())
  familyId    String?
  scope       String   @default("FAMILY") // SYSTEM | FAMILY
  title       String
  description String
  tier        String   // BRONZE | SILVER | GOLD | STELLAR
  iconKey     String   @default("trophy")
  isSecret    Boolean  @default(false)
  triggerType String   // MANUAL | TASK_APPROVED_COUNT | POINTS_EARNED | REWARD_APPROVED_COUNT | WISH_APPROVED_COUNT
  threshold   Int      @default(1)
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family  Family?      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  unlocks UserTrophy[]

  @@index([scope, familyId, isActive])
}

model UserTrophy {
  id         String   @id @default(cuid())
  trophyId   String
  userId     String
  source     String   // AUTOMATIC | MANUAL | RETROACTIVE
  awardedBy  String?
  unlockedAt DateTime @default(now())

  trophy TrophyDefinition @relation(fields: [trophyId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trophyId, userId])
  @@index([userId, unlockedAt])
}
